---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <h1>Hi, I'm Yashaswi.</h1>
      <p>
        I work in product management and growth marketing, split between
        product strategy and hands-on performance marketing: Meta Ads, SEO,
        conversion funnels, SQL dashboards. Outside of that I paint, write,
        and spend more time in SQL than the job strictly requires.
      </p>
      <p>
        Head to the <a href="/blog">blog</a> for posts, or read
        <a href="/about">more about me</a>.
      </p>
    </main>
    <Footer />
  </body>
</html>
