---
const year = new Date().getFullYear();
---

<footer>
  <p>&copy; {year} Yashaswi Patel. Built with Astro.</p>
</footer>

<style>
  footer {
    max-width: var(--column-width);
    margin: 0 auto;
    padding: 2rem 1.25rem 3rem;
    border-top: 1px solid var(--border);
    font-size: 0.85rem;
    opacity: 0.7;
  }

  footer p {
    margin: 0;
  }
</style>
